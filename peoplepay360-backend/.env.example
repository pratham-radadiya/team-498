# Copy this file to .env and fill in real values. Never commit .env.

# --- Phase 0: Database (local PostgreSQL instance, via Prisma) ---
# A local PostgreSQL 18 service is already running on localhost:5432.
# Create the database once: `createdb peoplepay360` (or via psql: `CREATE DATABASE peoplepay360;`)
# then fill in the actual local superuser/role username and password below.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/peoplepay360?schema=public"

# --- Phase 0: Auth (NextAuth.js / Auth.js) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-base64-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Phase 6: Email delivery (Payslip sending) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="replace-with-smtp-username"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="PeoplePay360 <payroll@example.com>"
